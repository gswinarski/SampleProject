<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_case" targetNamespace="urn:demo"><bpmn:process id="case" isExecutable="false"><bpmn:startEvent id="case_0" name="New Case"/><bpmn:task id="case_1" name="Assess priority"/><bpmn:task id="case_2" name="Escalate to a specialist"/><bpmn:endEvent id="case_3" name="Case resolved"/><bpmn:sequenceFlow id="case_flow_0" sourceRef="case_0" targetRef="case_1"/><bpmn:sequenceFlow id="case_flow_1" sourceRef="case_1" targetRef="case_2"/><bpmn:sequenceFlow id="case_flow_2" sourceRef="case_2" targetRef="case_3"/></bpmn:process><bpmndi:BPMNDiagram id="diagram_case"><bpmndi:BPMNPlane id="plane_case" bpmnElement="case"><bpmndi:BPMNShape id="shape_0" bpmnElement="case_0"><dc:Bounds x="100" y="122" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_1" bpmnElement="case_1"><dc:Bounds x="320" y="100" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_2" bpmnElement="case_2"><dc:Bounds x="540" y="100" width="150" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="shape_3" bpmnElement="case_3"><dc:Bounds x="760" y="122" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="edge_0" bpmnElement="case_flow_0"><di:waypoint x="136" y="140"/><di:waypoint x="320" y="140"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge_1" bpmnElement="case_flow_1"><di:waypoint x="470" y="140"/><di:waypoint x="540" y="140"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="edge_2" bpmnElement="case_flow_2"><di:waypoint x="690" y="140"/><di:waypoint x="760" y="140"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>